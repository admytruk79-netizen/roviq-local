{
  "name": "roviq-local",
  "version": "0.3.0",
  "private": true,
  "description": "ROVIQ Local — a global driver-curated, map-based local discovery guide.",
  "scripts": {
    "build": "node -e \"console.log('ROVIQ Local is a static Cloudflare Pages app; public/ is ready to deploy.')\"",
    "dev": "wrangler pages dev public --d1=DB",
    "deploy": "wrangler pages deploy public",
    "db:migrate": "wrangler d1 execute roviq-local --file=./schema.sql",
    "db:seed": "wrangler d1 execute roviq-local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute roviq-local --remote --file=./schema.sql",
    "db:migrate:v2:remote": "wrangler d1 execute roviq-local --remote --file=./migrations/002_product_v2.sql",
    "db:migrate:global:remote": "wrangler d1 execute roviq-local --remote --file=./migrations/0003_global_markets.sql",
    "db:seed:remote": "wrangler d1 execute roviq-local --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
